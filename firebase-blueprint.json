{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for TeiscoGames network",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier matching Auth UID",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 255
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the player or administrator",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL",
          "maxLength": 2048
        },
        "role": {
          "type": "string",
          "description": "Role determining permissions",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "Game": {
      "title": "Game",
      "description": "A web game or website hosted on GitHub Pages or custom domain",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Game document identifier",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the game or website",
          "minLength": 2,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Summary and instructions for the game",
          "minLength": 5,
          "maxLength": 1000
        },
        "imageUrl": {
          "type": "string",
          "description": "Cover banner or thumbnail URL",
          "minLength": 5,
          "maxLength": 2048
        },
        "gameUrl": {
          "type": "string",
          "description": "Target URL on GitHub Pages or web",
          "minLength": 5,
          "maxLength": 2048
        },
        "category": {
          "type": "string",
          "description": "Game category or genre",
          "maxLength": 50
        },
        "featured": {
          "type": "boolean",
          "description": "Whether to highlight on homepage"
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who added the game",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Publish timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last edit timestamp"
        }
      },
      "required": ["title", "description", "imageUrl", "gameUrl", "createdBy", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Network announcement or update published by administrators",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Announcement identifier",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Announcement headline",
          "minLength": 2,
          "maxLength": 150
        },
        "content": {
          "type": "string",
          "description": "Full text of the announcement",
          "minLength": 5,
          "maxLength": 3000
        },
        "category": {
          "type": "string",
          "description": "Category badge like Update, Event, or Maintenance",
          "maxLength": 50
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether to pin announcement at top"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the author",
          "maxLength": 100
        },
        "authorEmail": {
          "type": "string",
          "description": "Author email",
          "maxLength": 255
        },
        "createdBy": {
          "type": "string",
          "description": "Admin UID who created the announcement",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Modification timestamp"
        }
      },
      "required": ["title", "content", "createdBy", "createdAt"]
    },
    "Playtime": {
      "title": "Playtime",
      "description": "User gameplay duration record for a specific game on the TeiscoGames network",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the player",
          "minLength": 1,
          "maxLength": 128
        },
        "gameId": {
          "type": "string",
          "description": "ID of the game played",
          "minLength": 1,
          "maxLength": 128
        },
        "gameTitle": {
          "type": "string",
          "description": "Title of the game",
          "maxLength": 100
        },
        "totalSeconds": {
          "type": "integer",
          "description": "Cumulative playtime in seconds tracked via interval timer"
        },
        "lastPlayedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of most recent session"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when playtime was synced to Firestore"
        }
      },
      "required": ["userId", "gameId", "totalSeconds", "lastPlayedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles with assigned roles (user, admin)"
    },
    "/users/{userId}/playtimes/{gameId}": {
      "schema": {
        "$ref": "#/entities/Playtime"
      },
      "description": "Playtime duration tracking per game for a user"
    },
    "/games/{gameId}": {
      "schema": {
        "$ref": "#/entities/Game"
      },
      "description": "Catalog of games and websites on the TeiscoGames network"
    },
    "/announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/Announcement"
      },
      "description": "News and announcements posted by administrators"
    }
  }
}

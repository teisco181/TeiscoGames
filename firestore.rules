rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'teisco181@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Test connection probe allowed for signed in users
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // Users Collection Validation & Rules
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt', 'photoURL']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['user', 'admin'] &&
             (data.role == 'user' || request.auth.token.email == 'teisco181@gmail.com' || isAdmin()) &&
             data.createdAt is timestamp &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && 
                    isValidId(userId) && 
                    userId == request.auth.uid &&
                    isValidUser(incoming()) &&
                    incoming().createdAt == request.time;

      allow update: if isSignedIn() && 
                    isValidId(userId) && 
                    isValidUser(incoming()) && 
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt &&
                    (
                      isAdmin() || 
                      (
                        isOwner(userId) && 
                        incoming().role == existing().role &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
                      )
                    );

      allow delete: if isAdmin();

      // Playtime Subcollection Validation & Rules
      function isValidPlaytime(data) {
        return data.keys().hasAll(['userId', 'gameId', 'totalSeconds', 'lastPlayedAt']) &&
               data.keys().hasOnly(['userId', 'gameId', 'gameTitle', 'totalSeconds', 'lastPlayedAt', 'updatedAt']) &&
               data.userId is string && data.userId == request.auth.uid &&
               data.gameId is string && data.gameId.size() <= 128 &&
               data.totalSeconds is int && data.totalSeconds >= 0 &&
               data.lastPlayedAt is timestamp &&
               (!('gameTitle' in data) || (data.gameTitle is string && data.gameTitle.size() <= 100)) &&
               (!('updatedAt' in data) || data.updatedAt is timestamp);
      }

      match /playtimes/{gameId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create, update: if isSignedIn() && 
                              isOwner(userId) && 
                              isValidId(gameId) && 
                              isValidPlaytime(incoming());
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // Games Collection Validation & Rules
    function isValidGame(data) {
      return data.keys().hasAll(['title', 'description', 'imageUrl', 'gameUrl', 'createdBy', 'createdAt']) &&
             data.keys().hasOnly(['id', 'title', 'description', 'imageUrl', 'gameUrl', 'category', 'featured', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
             data.imageUrl is string && data.imageUrl.size() >= 5 && data.imageUrl.size() <= 2048 &&
             data.gameUrl is string && data.gameUrl.size() >= 5 && data.gameUrl.size() <= 2048 &&
             data.createdBy is string && data.createdBy == request.auth.uid &&
             data.createdAt is timestamp &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /games/{gameId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() && 
                    isValidId(gameId) && 
                    isValidGame(incoming()) && 
                    incoming().createdAt == request.time;

      allow update: if isAdmin() && 
                    isValidId(gameId) && 
                    isValidGame(incoming()) && 
                    incoming().createdBy == existing().createdBy &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['id', 'title', 'description', 'imageUrl', 'gameUrl', 'category', 'featured', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(gameId);
    }

    // Announcements Collection Validation & Rules
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'createdBy', 'createdAt']) &&
             data.keys().hasOnly(['id', 'title', 'content', 'category', 'isPinned', 'authorName', 'authorEmail', 'createdBy', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.content is string && data.content.size() >= 5 && data.content.size() <= 3000 &&
             data.createdBy is string && data.createdBy == request.auth.uid &&
             data.createdAt is timestamp &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 255)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();

      allow create: if isAdmin() && 
                    isValidId(announcementId) && 
                    isValidAnnouncement(incoming()) && 
                    incoming().createdAt == request.time;

      allow update: if isAdmin() && 
                    isValidId(announcementId) && 
                    isValidAnnouncement(incoming()) && 
                    incoming().createdBy == existing().createdBy &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['id', 'title', 'content', 'category', 'isPinned', 'authorName', 'authorEmail', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(announcementId);
    }
  }
}
